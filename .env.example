# Database
DATABASE_URL=postgres://user:pass@localhost:5432/ataqu

# JWT
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_bytes

# Admin
ADMIN_TOKEN=change_this_to_a_secure_token
ATAQU_ADMIN_SOCK=/tmp/ataqu-admin.sock

# OAuth (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.ataqu.com/api/v1/aegis/oauth/google/callback

# OAuth (Microsoft)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=https://api.ataqu.com/api/v1/aegis/oauth/microsoft/callback

# Shopify
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_REDIRECT_URI=https://api.ataqu.com/api/v1/vault/shopify/callback
SHOPIFY_SHOP=your-shop.myshopify.com

# S3
S3_BUCKET=your-s3-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Encryption (for Shopify tokens, etc.) - 32 bytes base64
ENCRYPTION_KEY=base64_encoded_32_byte_key

# SMTP (for email sending)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional
LOW_STOCK_THRESHOLD=5
