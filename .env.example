# ---- Database (must match docker-compose.yml below) ----
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/ataqu

# ---- Secrets (generate: openssl rand -base64 32) ----
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_bytes
CSRF_SECRET=REPLACE_WITH_openssl_rand_-base64_32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_-base64_32

# ---- Admin UDS (token REQUIRED, >=16 chars; see task H1) ----
ADMIN_TOKEN=change_this_to_a_secure_token_min_16_chars
ATAQU_ADMIN_SOCK=/tmp/ataqu-admin.sock

# ---- Runtime ----
RUST_LOG=info,ataqu=debug
TRUSTED_PROXIES=
SYSTEM_USER_ID=
EMAIL_SPILL_DIR=./var/email-spill
APPROVAL_NOTIFY_CHANNEL_ID=

# ---- S3 (local MinIO from docker-compose.yml) ----
S3_BUCKET=ataqu-dev
S3_ENABLED=true
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=ataqu
AWS_SECRET_ACCESS_KEY=ataqu-secret

# ---- OAuth (leave empty to disable) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/aegis/sso/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/api/aegis/sso/callback

# ---- Shopify ----
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:5173/api/vault/shopify/callback
SHOPIFY_SHOP=

# ---- SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=

LOW_STOCK_THRESHOLD=5
