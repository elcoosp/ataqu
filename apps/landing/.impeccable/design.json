{
	"version": 2,
	"name": "Ataqu Landing Page",
	"description": "10 apps, one price, zero lock\u2011in \u2014 the Calm Predator",
	"tokens": {
		"colors": {
			"background": "#0A1628",
			"foreground": "#F8F9FA",
			"primary": "#F59E0B",
			"primary-foreground": "#0A1628",
			"muted": "#64748B",
			"muted-foreground": "#94A3B8",
			"card": "#0F1A2E",
			"card-foreground": "#F8F9FA",
			"border": "#1E2A3A",
			"ring": "#F59E0B",
			"success": "#10B981",
			"error": "#EF4444"
		},
		"typography": {
			"display": {
				"fontFamily": "Unbounded, system-ui, sans-serif",
				"fontSize": "clamp(2.5rem, 7vw, 4.5rem)",
				"fontWeight": 700,
				"lineHeight": 1.1,
				"letterSpacing": "-0.03em"
			},
			"body": {
				"fontFamily": "Inter, system-ui, -apple-system, sans-serif",
				"fontSize": "1rem",
				"fontWeight": 400,
				"lineHeight": 1.6
			},
			"mono": {
				"fontFamily": "JetBrains Mono, monospace",
				"fontSize": "0.875rem",
				"fontWeight": 400
			}
		},
		"spacing": {
			"xs": "4px",
			"sm": "8px",
			"md": "16px",
			"lg": "24px",
			"xl": "48px",
			"xxl": "64px"
		},
		"rounded": {
			"sm": "4px",
			"md": "8px",
			"lg": "12px",
			"full": "9999px"
		}
	},
	"components": {
		"button-primary": {
			"backgroundColor": "{colors.primary}",
			"textColor": "{colors.primary-foreground}",
			"rounded": "{rounded.md}",
			"padding": "12px 32px",
			"fontWeight": 600,
			"hover": {
				"opacity": 0.9
			},
			"transition": "150ms ease-out"
		},
		"button-ghost": {
			"backgroundColor": "transparent",
			"textColor": "{colors.foreground}",
			"border": "1px solid {colors.border}",
			"rounded": "{rounded.md}",
			"padding": "12px 32px",
			"fontWeight": 400,
			"hover": {
				"backgroundColor": "{colors.card}"
			}
		},
		"button-destructive": {
			"backgroundColor": "{colors.error}",
			"textColor": "#FFFFFF",
			"padding": "12px 32px",
			"rounded": "{rounded.md}",
			"fontWeight": 600,
			"hover": {
				"opacity": 0.9
			}
		},
		"card": {
			"border": "1px solid {colors.border}",
			"backgroundColor": "{colors.card}",
			"padding": "16px",
			"rounded": "{rounded.md}",
			"hover": {
				"backgroundColor": "{colors.card}"
			}
		},
		"input": {
			"height": "36px",
			"border": "1px solid {colors.border}",
			"backgroundColor": "{colors.background}",
			"textColor": "{colors.foreground}",
			"padding": "8px 16px",
			"rounded": "{rounded.md}",
			"focus": {
				"ring": "2px solid {colors.ring}",
				"ringOffset": "2px"
			},
			"placeholder": "{colors.muted-foreground}"
		},
		"table": {
			"rowHeight": "40px",
			"border": "1px solid {colors.border}",
			"header": {
				"color": "{colors.muted-foreground}",
				"fontFamily": "{typography.display.fontFamily}",
				"fontSize": "0.875rem"
			},
			"highlightRow": {
				"backgroundColor": "rgba(245, 158, 11, 0.05)"
			}
		}
	},
	"narrative": {
		"northStar": "The Calm Predator \u2014 precise, confident, aggressive toward incumbents.",
		"rules": [
			"Dark mode native with Deep Night Blue background.",
			"Amber for CTAs and key data points only.",
			"Borders for separation, not shadows.",
			"8px grid for all spacing.",
			"Unbounded for headings, Inter for body.",
			"High contrast, dense but breathable information density."
		],
		"dos": [
			"Use the 8px grid for all spacing.",
			"Use amber for CTAs and key data points.",
			"Use borders for separation, not shadows.",
			"Keep dark mode native.",
			"Use dense data tables (40px row height).",
			"Respect prefers-reduced-motion.",
			"Use semantic HTML and ARIA labels.",
			"Provide keyboard focus states (2px amber ring)."
		],
		"donts": [
			"Don't use emojis as icons (use Lucide icons).",
			"Don't use glassmorphism or soft shadows.",
			"Don't use gradient text.",
			"Don't use exclamation marks in copy.",
			"Don't use full\u2011page loading spinners.",
			"Don't use 'seamless', 'robust', 'empower' in copy."
		]
	}
}
