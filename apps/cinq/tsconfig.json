{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "skipDefaultLibCheck": true,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "../../packages/**/*",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
